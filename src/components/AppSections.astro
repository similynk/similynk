---
// One section per app, each with small pictures of the app in its own (always dark) colours.
---

<section class="band" id="ship">
  <div class="wrap">
    <div class="kicker">
      <span class="eyebrow"><img src="/ship-icon.svg" alt="" width="26" height="26" />Ship</span>
      <h2>Your family, your friends, and nobody else.</h2>
      <p>Chats, a family tree you build together, circles for college or work, and photos that go to exactly who you choose.</p>
    </div>
    <div class="tiles">
      <article class="tile">
        <div class="vig" aria-hidden="true">
          <div class="bub them">Reached home safely?</div>
          <div class="bub me">Yes, just now <span class="tick seen">✓✓</span></div>
          <div class="bub me">Sending the photos tonight <span class="tick">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
          </span></div>
        </div>
        <h3>Chats that work offline</h3>
        <p>Kept on your phone, encrypted, so they open instantly. Messages sent offline wait and go once you're back.</p>
      </article>
      <article class="tile">
        <div class="vig" aria-hidden="true">
          <div class="rings">
            <span class="ring"><i><b style="background:#0f766e">You</b></i>You</span>
            <span class="ring"><i><b style="background:#be185d">H</b></i>Grandma</span>
            <span class="ring"><i><b style="background:#4f46e5">E</b></i>Ethan</span>
            <span class="ring seen"><i><b style="background:#92400e">C</b></i>Chloe</span>
          </div>
        </div>
        <h3>Stories for 24 hours</h3>
        <p>A photo, a video or a few words, for your family or for everyone you know. Then it's gone.</p>
      </article>
      <article class="tile">
        <div class="vig" aria-hidden="true">
          <div class="cap">College friends · invite code</div>
          <div class="code"><span>K</span><span>7</span><span>M</span><span>Q</span><span>2</span><span>X</span></div>
        </div>
        <h3>Circles</h3>
        <p>For college, school or work. Share a code or a link and people join themselves, with a group chat ready.</p>
      </article>
    </div>
  </div>
</section>

<section class="band alt" id="muso">
  <div class="wrap">
    <div class="kicker">
      <span class="eyebrow"><img src="/muso-icon.svg" alt="" width="26" height="26" />Muso</span>
      <h2>All your music. Free, and no ads.</h2>
      <p>Stream anything, download what you love, play the files already on your phone, and listen together in Rooms.</p>
    </div>
    <div class="tiles four">
      <article class="tile">
        <div class="vig" aria-hidden="true">
          <div class="row"><span class="cover" style="background:linear-gradient(135deg,#f59e0b,#be185d)"></span><span><b>Golden Hour Drive</b><small>Saved · High quality</small></span><span class="dot"></span></div>
          <div class="qual"><span>Normal</span><span class="on">High</span><span>Best</span></div>
        </div>
        <h3>Downloads</h3>
        <p>Pick the quality, keep them in Muso or any folder on your phone.</p>
      </article>
      <article class="tile">
        <div class="vig" aria-hidden="true">
          {
            [
              ['Music/WhatsApp Audio', '38 songs'],
              ['Download', '112 songs'],
            ].map(([folder, count]) => (
              <div class="row">
                <span class="cover folder">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
                    <path d="M3 6.5A1.5 1.5 0 0 1 4.5 5H9l2 2.5h8.5A1.5 1.5 0 0 1 21 9v8.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5Z" />
                  </svg>
                </span>
                <span><b>{folder}</b><small>{count}</small></span>
              </div>
            ))
          }
        </div>
        <h3>Your phone's music</h3>
        <p>Files on your phone, by folder. Delete one and it's gone from Muso too.</p>
      </article>
      <article class="tile">
        <div class="vig" aria-hidden="true">
          <div class="field">open.spotify.com/playlist/37i9dQZF…</div>
          <div class="matched">42 of 44 songs found ✓</div>
        </div>
        <h3>Bring your playlists</h3>
        <p>Paste a Spotify or JioSaavn link and your playlist or album comes across.</p>
      </article>
      <article class="tile">
        <div class="vig" aria-hidden="true">
          <div class="faces"><i style="background:#0f766e">E</i><i style="background:#be185d">C</i><i style="background:#4f46e5">L</i><i style="background:#e25e00">+3</i></div>
          <div class="room"><b>Sunday drive</b><small>6 listening · in sync</small></div>
        </div>
        <h3>Rooms</h3>
        <p>Play the same song at the same moment, on the app or the web.</p>
      </article>
    </div>
  </div>
</section>

<style>
  .kicker {
    margin-bottom: 44px;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 600 12px var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .eyebrow img {
    border-radius: 8px;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .tiles.four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .tile {
    border: 1px solid var(--line-2);
    border-radius: 20px;
    background: var(--panel);
    padding: 18px;
    display: grid;
    gap: 14px;
    align-content: start;
    min-width: 0;
  }
  h3 {
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .tile p {
    color: var(--ink-2);
    font-size: 14.5px;
  }
  .vig {
    border-radius: 14px;
    background: var(--app);
    color: var(--app-ink);
    padding: 14px;
    display: grid;
    gap: 8px;
    min-height: 150px;
    align-content: center;
    font-size: 13px;
    border: 1px solid var(--app-line);
  }
  .bub {
    display: flex;
    align-items: center;
    gap: 6px;
    max-width: 78%;
    padding: 7px 11px;
    border-radius: 14px;
    font-size: 12.5px;
    line-height: 1.35;
  }
  .bub.them {
    background: var(--app-3);
    justify-self: start;
    border-bottom-left-radius: 4px;
  }
  .bub.me {
    background: var(--accent);
    color: #fff;
    justify-self: end;
    border-bottom-right-radius: 4px;
  }
  .tick {
    display: inline-flex;
    vertical-align: middle;
    flex: none;
    font-size: 10.5px;
    opacity: 0.85;
  }
  .tick.seen {
    color: #ffd2b3;
  }
  .rings {
    display: flex;
    gap: 10px;
    justify-content: center;
  }
  .ring {
    display: grid;
    justify-items: center;
    gap: 4px;
    font-size: 11px;
    color: var(--app-mute);
  }
  .ring i {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    padding: 2.5px;
    background: conic-gradient(var(--accent), #ffb37a, var(--accent));
    display: block;
  }
  .ring.seen i {
    background: var(--wire);
  }
  .ring i b {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2.5px solid var(--app);
    font-style: normal;
    font-size: 14px;
    color: #fff;
  }
  .cap {
    text-align: center;
    font-size: 12px;
    color: var(--app-mute);
  }
  .code {
    display: flex;
    gap: 5px;
    justify-content: center;
  }
  .code span {
    width: 26px;
    height: 34px;
    border-radius: 8px;
    background: var(--app-3);
    display: grid;
    place-items: center;
    font: 600 15px var(--mono);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .row b {
    font-size: 12.5px;
    display: block;
  }
  .row small,
  .room small {
    color: var(--app-mute);
    font-size: 11px;
    display: block;
  }
  .cover {
    width: 34px;
    height: 34px;
    border-radius: 7px;
    flex: none;
  }
  .cover.folder {
    background: #23242e;
    display: grid;
    place-items: center;
    color: #c0c1cc;
  }
  .dot {
    margin-left: auto;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--green);
  }
  .qual {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .qual span {
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--app-3);
    font-size: 11.5px;
    font-weight: 700;
    color: #c0c1cc;
  }
  .qual span.on {
    background: var(--accent);
    color: #fff;
  }
  .field {
    border: 1px solid var(--app-line);
    border-radius: 10px;
    padding: 8px 10px;
    font: 500 11.5px var(--mono);
    color: var(--app-mute);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .matched {
    font-size: 12px;
    color: var(--green);
    font-weight: 700;
  }
  .faces {
    display: flex;
  }
  .faces i {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid var(--app);
    margin-left: -8px;
    display: grid;
    place-items: center;
    font-style: normal;
    font-size: 11px;
    font-weight: 800;
    color: #fff;
  }
  .faces i:first-child {
    margin-left: 0;
  }
  .room b {
    font-size: 12.5px;
  }
  @media (max-width: 960px) {
    .tiles,
    .tiles.four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .tiles,
    .tiles.four {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
