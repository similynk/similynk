---
import Icon from './Icon.astro';
import { RELEASES_PAGE } from '../data/site';

const year = new Date().getFullYear();
const links = [
  { label: 'Docs', href: '/docs/' },
  { label: 'Updates', href: '/docs/updates/' },
  { label: 'Support', href: '/docs/support/' },
  { label: 'Privacy', href: '/docs/privacy/' },
  { label: 'Terms', href: '/docs/terms/' },
  { label: 'Child safety', href: '/docs/child-safety/' },
  { label: 'Delete account', href: '/docs/delete-account/' },
  { label: 'All releases', href: RELEASES_PAGE },
];
---

<footer>
  <div class="wrap">
    <a class="brand" href="/"><Icon name="logo" size={18} />Similynk</a>
    <nav aria-label="Footer">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <span class="copy">© {year} Similynk</span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding-block: 36px 56px;
    font-size: 13.5px;
    color: var(--ink-3);
  }
  .wrap {
    max-width: 1200px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: 15px;
    color: var(--ink);
    text-decoration: none;
  }
  .brand :global(svg) {
    color: var(--accent);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  nav a {
    color: var(--ink-2);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--ink);
  }
  .copy {
    margin-left: auto;
  }
  @media (max-width: 600px) {
    .copy {
      margin-left: 0;
    }
  }
</style>
