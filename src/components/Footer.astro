---
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <span>© {year} Similynk</span>
    <nav aria-label="Footer">
      <a href="/#get">Download</a>
      <a href="/docs/">Docs</a>
      <a href="/docs/updates/">Updates</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding-block: 32px 56px;
    font-size: 13.5px;
    color: var(--ink-3);
  }
  .wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  a {
    text-decoration: none;
    color: var(--ink-2);
  }
  a:hover {
    color: var(--ink);
  }
</style>
