---
const stats = [
  { value: '0', text: 'ads, sponsored posts or suggested strangers' },
  { value: '1', text: 'audience per post, chosen by you before you share' },
  { value: '2', text: 'sides confirm every family link, so nobody adds themselves to yours' },
];
---

<section class="band" id="why">
  <div class="wrap">
    <div class="kicker">
      <h2>Built for connection, not attention.</h2>
      <p>
        Most social apps are designed to keep you scrolling. Similynk is designed to let you catch up with the
        people you love, then get on with your day.
      </p>
    </div>
    <div class="stats">
      {
        stats.map((s) => (
          <div class="stat">
            <b>{s.value}</b>
            <span>{s.text}</span>
          </div>
        ))
      }
    </div>
    <p class="note">
      Strangers can't find you by name. To reach you, someone needs your exact email or phone number, or a place in
      your family or circles. <a href="/docs/chats/">Who can message you →</a>
    </p>
  </div>
</section>

<style>
  .stats {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--line-2);
    border-radius: 16px;
    overflow: hidden;
  }
  .stat {
    padding: 28px 26px;
    display: grid;
    gap: 8px;
    min-width: 0;
  }
  .stat + .stat {
    border-left: 1px solid var(--line-2);
  }
  .stat b {
    font: 500 clamp(40px, 5vw, 54px) var(--mono);
    letter-spacing: -0.04em;
    color: var(--accent-ink);
    line-height: 1;
  }
  .stat span {
    font-size: 14.5px;
    color: var(--ink-2);
  }
  .note {
    margin-top: 18px;
    font-size: 14px;
    color: var(--ink-3);
    max-width: 62ch;
  }
  .note a {
    color: var(--accent-ink);
    text-decoration: none;
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .stats {
      grid-template-columns: 1fr;
    }
    .stat + .stat {
      border-left: 0;
      border-top: 1px solid var(--line-2);
    }
  }
</style>
