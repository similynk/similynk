---
const stats = [
  { value: '0', text: 'ads, sponsored posts or suggested strangers' },
  { value: '1', text: 'audience per post, chosen by you before you share' },
  { value: '2', text: 'sides confirm every family link, so nobody adds themselves to yours' },
];
---

<section class="band" id="why">
  <div class="wrap">
    <div class="kicker">
      <h2>Built for connection, not attention.</h2>
      <p>
        Most social apps are designed to keep you scrolling. Similynk lets you catch up with the people you love, then
        get on with your day.
      </p>
    </div>
    <div class="stats">
      {
        stats.map((s) => (
          <div class="stat">
            <b>{s.value}</b>
            <span>{s.text}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stats {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--line-2);
    border-radius: 20px;
    overflow: hidden;
  }
  .stat {
    padding: 30px 28px;
    display: grid;
    gap: 6px;
    min-width: 0;
  }
  .stat + .stat {
    border-left: 1px solid var(--line-2);
  }
  .stat b {
    font-size: 64px;
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--accent-ink);
  }
  .stat span {
    color: var(--ink-2);
  }
  @media (max-width: 760px) {
    .stats {
      grid-template-columns: minmax(0, 1fr);
    }
    .stat + .stat {
      border-left: 0;
      border-top: 1px solid var(--line-2);
    }
  }
</style>
