---
// Illustrations of the app in its own (always dark) colours.
const chats = [
  { initials: 'SL', color: '#AB68BA', name: 'Sana', text: 'Look at this sunset 🌅', time: '2:41 PM', unread: 2 },
  { initials: 'NL', color: '#009EA7', name: 'Mom', text: 'Dinner at 8?', time: '1:15 PM' },
  { initials: 'RV', color: '#2563EB', name: 'Rahul', text: "Notes from today's lecture", time: '11:02 AM', unread: 1 },
  { initials: 'DL', color: '#549A44', name: 'Dev', text: 'You: see you Saturday', time: 'Yesterday' },
  { initials: 'AN', color: '#A78100', name: 'Anya', text: 'Joined College friends', time: 'Mon' },
  { initials: 'TS', color: '#C35F92', name: 'Theo', text: 'Haha same playlist!', time: 'Sun' },
];

const tree = [
  [
    { initials: 'SL', color: '#497EB3', name: 'Suresh', relation: 'Grandparent', size: 36 },
    { initials: 'ML', color: '#B46767', name: 'Meena', relation: 'Grandparent', size: 36 },
  ],
  [
    { initials: 'AL', color: '#848F02', name: 'Arjun', relation: 'Parent', size: 40 },
    { initials: 'NL', color: '#009EA7', name: 'Nisha', relation: 'Parent', size: 40 },
  ],
  [
    { initials: 'DL', color: '#549A44', name: 'Dev', relation: 'Sibling', size: 44 },
    { initials: 'YOU', color: '#E25E00', name: 'You', relation: '', size: 48, me: true },
    { initials: 'SL', color: '#AB68BA', name: 'Sana', relation: 'Sibling', size: 44 },
  ],
];
---

<div class="shot" aria-hidden="true">
  <div class="screen side">
    <div class="s-top"><b>Family</b></div>
    <div class="tree">
      {
        tree.map((gen, i) => (
          <>
            {i > 0 && <div class="dash" />}
            <div class="gen">
              {gen.map((p) => (
                <div class="node">
                  <div class="oct" style={`width:${p.size}px;height:${p.size}px;background:${p.color}`}>
                    {p.initials}
                  </div>
                  <b class:list={{ me: p.me }}>{p.name}</b>
                  <small>{p.relation || ' '}</small>
                </div>
              ))}
            </div>
          </>
        ))
      }
    </div>
  </div>

  <div class="screen mid">
    <div class="s-top"><b>Chats</b><span class="s-av">NL</span></div>
    <div class="s-search">Search chats</div>
    {
      chats.map((c) => (
        <div class="s-row">
          <span class="av" style={`background:${c.color}`}>{c.initials}</span>
          <span class="t">
            <b>{c.name}</b>
            <span>{c.text}</span>
          </span>
          <span class="m">
            {c.time}
            {c.unread && <span class="u">{c.unread}</span>}
          </span>
        </div>
      ))
    }
  </div>

  <div class="screen side">
    <div class="s-top"><b>Feed</b></div>
    <div class="post">
      <div class="h">
        <span class="av" style="background:#AB68BA">SL</span>
        <span><b>Sana</b><small><span class="tag">Family</span>2h ago</small></span>
      </div>
      <div class="img"></div>
      <div class="c">Sunday lunch with everyone ♥ 8</div>
    </div>
    <div class="post">
      <div class="h">
        <span class="av" style="background:#009EA7">NL</span>
        <span><b>Mom</b><small><span class="tag">Whole tree</span>1d ago</small></span>
      </div>
      <div class="img green"></div>
    </div>
  </div>
</div>

<style>
  .shot {
    position: relative;
    margin: 72px auto 0;
    max-width: 980px;
    padding: 28px 28px 0;
    border: 1px solid var(--line-2);
    border-bottom: 0;
    border-radius: 22px 22px 0 0;
    background: linear-gradient(to bottom, var(--bg-2), var(--bg));
    box-shadow: var(--shadow);
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 22px;
    overflow: hidden;
  }
  .screen {
    width: 250px;
    height: 470px;
    border-radius: 30px 30px 0 0;
    border: 6px solid #22232c;
    border-bottom: 0;
    background: #0a0b11;
    color: #f0eeeb;
    overflow: hidden;
    flex: 0 0 auto;
    font-size: 12px;
    text-align: left;
  }
  .mid {
    width: 280px;
    height: 520px;
  }
  .side {
    opacity: 0.9;
  }
  .s-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px 6px;
  }
  .s-top b {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .s-av {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #e25e00;
    display: grid;
    place-items: center;
    font-size: 10px;
    font-weight: 800;
    color: #fff;
  }
  .s-search {
    margin: 6px 16px 10px;
    padding: 8px 12px;
    border-radius: 11px;
    background: #191a21;
    color: #7e7f89;
    font-size: 11.5px;
  }
  .s-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
  }
  .av {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    font-weight: 800;
    font-size: 11px;
    flex: 0 0 auto;
  }
  .t {
    flex: 1;
    min-width: 0;
  }
  .t b {
    display: block;
    font-size: 12.5px;
  }
  .t span {
    display: block;
    font-size: 11px;
    color: #7e7f89;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .m {
    font: 500 9.5px var(--mono);
    color: #70717a;
    display: grid;
    justify-items: end;
    gap: 4px;
  }
  .u {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #e25e00;
    color: #fff;
    font-size: 9px;
    font-weight: 800;
    display: grid;
    place-items: center;
  }
  .tree {
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: 18px 8px;
  }
  .gen {
    display: flex;
    gap: 14px;
  }
  .node {
    display: grid;
    justify-items: center;
    gap: 3px;
    width: 56px;
    text-align: center;
  }
  .node b {
    font-size: 10.5px;
  }
  .node b.me {
    color: #fca676;
  }
  .node small {
    font-size: 9px;
    color: #e25e00;
    font-weight: 700;
  }
  .oct {
    clip-path: polygon(30% 0, 70% 0, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0 70%, 0 30%);
    display: grid;
    place-items: center;
    color: #fff;
    font-weight: 800;
    font-size: 11px;
  }
  .dash {
    width: 2px;
    height: 16px;
    background: repeating-linear-gradient(#5c5d68 0 4px, transparent 4px 7px);
  }
  .post {
    margin: 8px 14px;
    border-radius: 14px;
    background: #191a21;
    overflow: hidden;
  }
  .post .h {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px;
  }
  .post .h .av {
    width: 26px;
    height: 26px;
    font-size: 9.5px;
  }
  .post .h b {
    font-size: 11.5px;
  }
  .post .h small {
    display: block;
    font-size: 9.5px;
    color: #70717a;
  }
  .tag {
    font-size: 8.5px;
    font-weight: 700;
    color: #fca676;
    background: #4e270d;
    padding: 1px 6px;
    border-radius: 5px;
    margin-right: 4px;
  }
  .img {
    height: 120px;
    background: radial-gradient(circle at 30% 30%, #f59e0b, #9a3412 60%, #2b1206);
  }
  .img.green {
    background: radial-gradient(circle at 70% 40%, #86efac, #166534 60%, #052e16);
  }
  .c {
    padding: 8px 10px 10px;
    font-size: 11px;
    color: #c9c8ce;
  }
  @media (max-width: 900px) {
    .side {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .shot {
      margin-top: 48px;
      padding: 18px 12px 0;
    }
    .mid {
      width: 240px;
      height: 440px;
    }
  }
</style>
